{
  "name": "escala-porteiros",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Escala de porteiros CCB Jd. São Luiz — com área administrativa",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "npm run typecheck && npm run test && npm run test:fuso:berlim && npm run build",
    "prebuild": "node -e \"require('node:fs').rmSync('docs/assets',{recursive:true,force:true})\"",
    "test:fuso:berlim": "node scripts/testar-em-outro-fuso.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.533.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
